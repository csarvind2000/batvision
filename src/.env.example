###############################################################################
# BATVision — copy to .env and fill in.  `docker compose config` validates it.
###############################################################################

# --- host paths (absolute, outside Docker) -----------------------------------
# Case data. The stack writes results to <BAT_DATA_HOST_DIR>/output.
BAT_DATA_HOST_DIR=/media/ranjhaa-local/volume23/BAT/BAT_DataFolder

# Trained weights: the nnU-Net *results* tree, i.e. the directory that contains
# Dataset602_BAT_AGB/ and Dataset901_BAT_Longitudinal_UNION_45y_6y/.
# Mounted read-only at /models/nnunet_results.
BAT_MODELS_HOST_DIR=/media/ranjhaa-local/volume23/BAT/nnunet_bat/nnUNet_results

# Containers run unprivileged — this must be the UID/GID that owns the two
# directories above (`id -u`, `id -g`).
APP_UID=1001
APP_GID=1001

# --- model -------------------------------------------------------------------
# agbnet   AGB-Net, Dataset602 (default)
# baseline nnU-Net TopK10, Dataset901
BATAI_MODEL=agbnet
BATAI_DEVICE=cuda
BATAI_DISABLE_TTA=0
BATAI_DEBUG=0

# Force a specific model from the backend regardless of the AI default.
# Leave empty to use BATAI_MODEL.
AI_MODEL=

# Per-model overrides, if you need a fold/checkpoint other than the registry
# default (see ai/batai/config.py):
# BATAI_AGBNET_FOLDS=0
# BATAI_AGBNET_CHECKPOINT=checkpoint_best.pth
# BATAI_BASELINE_FOLDS=0

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change_me_to_a_long_random_string_64_chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
GUNICORN_WORKERS=3

# Container-internal paths — leave these alone unless you also change the mounts.
MEDIA_ROOT=/BAT_DataFolder/media
OUTPUT_ROOT=/storage/bat_outputs

# --- database / broker -------------------------------------------------------
POSTGRES_DB=bfit
POSTGRES_USER=bfit
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://bfit:change_me@db:5432/bfit

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- service wiring ----------------------------------------------------------
AI_BASE_URL=http://ai:9000
AI_INFER_PATH=/infer
AI_TIMEOUT_S=3600

# Dev (docker-compose.override.yml) talks to the backend directly.
# Production leaves this empty: the frontend's nginx proxies /api itself.
VITE_API_BASE_URL=http://localhost:8000

# --- host ports --------------------------------------------------------------
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=8000
AI_HOST_PORT=9000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# --- image tag ---------------------------------------------------------------
BATVISION_TAG=latest
